rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Authentication & ID Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Deny all legacy root collections explicitly (Defense in Depth)
    match /clients/{clientId} {
      allow read, write: if false;
    }
    match /meetings/{meetingId} {
      allow read, write: if false;
    }
    match /tasks/{taskId} {
      allow read, write: if false;
    }
    match /notes/{noteId} {
      allow read, write: if false;
    }

    // 4. Schema & Data Integrity Validation Helpers

    // User Profile Document Validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastLoginAt', 'createdAt'])
        && data.keys().hasAll(['uid'])
        && data.uid is string && data.uid == userId
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Client Validation
    function isValidClient(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'name', 'company', 'phone', 'email', 'notes', 'avatarPath', 'color', 'isFavorite', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'name'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('company' in data) || (data.company is string && data.company.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('avatarPath' in data) || (data.avatarPath is string && data.avatarPath.size() <= 500))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('isFavorite' in data) || data.isFavorite is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Meeting Validation
    function isValidMeeting(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'clientId', 'title', 'dateTime', 'duration', 'type', 'location', 'notes', 'status', 'photoPaths', 'isFollowUpScheduled', 'attendees', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'clientId', 'title', 'dateTime', 'type', 'status', 'notes'])
        && data.id is string && isValidId(data.id)
        && data.clientId is string && isValidId(data.clientId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.dateTime is string && data.dateTime.size() <= 50
        && data.type in ['in_person', 'phone', 'video', 'chat']
        && data.status in ['draft', 'confirmed', 'completed']
        && data.notes is string && data.notes.size() <= 10000
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('duration' in data) || (data.duration is number && data.duration >= 0 && data.duration <= 1440))
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('photoPaths' in data) || (data.photoPaths is list && data.photoPaths.size() <= 20))
        && (!('isFollowUpScheduled' in data) || data.isFollowUpScheduled is bool)
        && (!('attendees' in data) || (data.attendees is list && data.attendees.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Task Validation
    function isValidTask(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'meetingId', 'clientId', 'title', 'description', 'dueDate', 'priority', 'status', 'reminderDate', 'completedAt', 'provenance', 'createdAt'])
        && data.keys().hasAll(['id', 'clientId', 'title', 'priority', 'status'])
        && data.id is string && isValidId(data.id)
        && data.clientId is string && isValidId(data.clientId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.priority in ['urgent', 'high', 'medium', 'low']
        && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('meetingId' in data) || (data.meetingId is string && isValidId(data.meetingId)))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 50))
        && (!('reminderDate' in data) || (data.reminderDate is string && data.reminderDate.size() <= 50))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50))
        && (!('provenance' in data) || (data.provenance in ['source', 'ai_suggested', 'approved', 'uncertain']))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Note Validation
    function isValidNote(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'clientId', 'title', 'content', 'tags', 'isPinned', 'color', 'createdAt'])
        && data.keys().hasAll(['id', 'title', 'content', 'isPinned'])
        && data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 5000
        && data.isPinned is bool
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('clientId' in data) || (data.clientId is string && isValidId(data.clientId)))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // 5. User-Scoped Data Hierarchy (/users/{userId}/...)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && isValidUserProfile(incoming(), userId);
      allow delete: if false;

      // Scoped Subcollection: Clients
      match /clients/{clientId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(clientId)
          && incoming().id == clientId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidClient(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(clientId)
          && incoming().id == clientId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidClient(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      // Scoped Subcollection: Meetings
      match /meetings/{meetingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(meetingId)
          && incoming().id == meetingId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidMeeting(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(meetingId)
          && incoming().id == meetingId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidMeeting(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(meetingId);
      }

      // Scoped Subcollection: Tasks
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidTask(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidTask(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Scoped Subcollection: Notes
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidNote(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidNote(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
