rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Authentication & Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Initial connection testing document (Read-only check)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Legacy Root Collections - Explicitly Denied for Client Access
    match /clients/{clientId} {
      allow read, write: if false;
    }
    match /meetings/{meetingId} {
      allow read, write: if false;
    }
    match /tasks/{taskId} {
      allow read, write: if false;
    }
    match /notes/{noteId} {
      allow read, write: if false;
    }

    // 5. Data Model Validation Helpers

    function isValidClient(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('company' in data) || (data.company is string && data.company.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('color' in data) || (data.color is string && data.color.size() <= 20))
        && (!('isFavorite' in data) || data.isFavorite is bool);
    }

    function isValidMeeting(data) {
      return data.id is string && data.id.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.dateTime is string && data.dateTime.size() <= 50
        && data.type in ['in_person', 'phone', 'video', 'chat']
        && data.status in ['draft', 'confirmed', 'completed']
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('duration' in data) || data.duration is number)
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000));
    }

    function isValidTask(data) {
      return data.id is string && data.id.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.priority in ['urgent', 'high', 'medium', 'low']
        && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 50));
    }

    function isValidNote(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 5000
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('isPinned' in data) || data.isPinned is bool);
    }

    // 6. User-Scoped Data Hierarchy (/users/{userId}/...)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Scoped Subcollection: Clients
      match /clients/{clientId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(clientId)
          && incoming().id == clientId
          && isValidClient(incoming());
        allow update: if isOwner(userId)
          && isValidId(clientId)
          && incoming().id == clientId
          && incoming().id == existing().id
          && isValidClient(incoming());
        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      // Scoped Subcollection: Meetings
      match /meetings/{meetingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(meetingId)
          && incoming().id == meetingId
          && isValidMeeting(incoming());
        allow update: if isOwner(userId)
          && isValidId(meetingId)
          && incoming().id == meetingId
          && incoming().id == existing().id
          && isValidMeeting(incoming());
        allow delete: if isOwner(userId) && isValidId(meetingId);
      }

      // Scoped Subcollection: Tasks
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && isValidTask(incoming());
        allow update: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && incoming().id == existing().id
          && isValidTask(incoming());
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Scoped Subcollection: Notes
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && isValidNote(incoming());
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && incoming().id == existing().id
          && isValidNote(incoming());
        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
