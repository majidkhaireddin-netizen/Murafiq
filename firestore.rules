rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Authentication & ID Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasMeetingAttachmentLock(userId, meetingId) {
      return exists(/databases/$(database)/documents/users/$(userId)/meetings/$(meetingId)/uploadIntents/_meetingGuard)
        && get(/databases/$(database)/documents/users/$(userId)/meetings/$(meetingId)/uploadIntents/_meetingGuard).data.locked == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Deny all legacy root collections explicitly (Defense in Depth)
    match /clients/{clientId} {
      allow read, write: if false;
    }
    match /meetings/{meetingId} {
      allow read, write: if false;
    }
    match /tasks/{taskId} {
      allow read, write: if false;
    }
    match /notes/{noteId} {
      allow read, write: if false;
    }
    match /opportunities/{opportunityId} {
      allow read, write: if false;
    }
    match /opportunityStageEvents/{eventId} {
      allow read, write: if false;
    }

    // 4. Schema & Data Integrity Validation Helpers

    // User Profile Document Validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastLoginAt', 'createdAt'])
        && data.keys().hasAll(['uid'])
        && data.uid is string && data.uid == userId
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Client Validation
    function isValidClient(data, userId) {
      return data.keys().hasOnly([
          'id', 'userId', 'name', 'company', 'phone', 'email', 'notes',
          'avatarPath', 'color', 'isFavorite',
          'industry', 'category', 'relationshipStatus', 'importance',
          'tags', 'website', 'address', 'source', 'description', 'contacts',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['id', 'name'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('company' in data) || (data.company is string && data.company.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('avatarPath' in data) || (data.avatarPath is string && data.avatarPath.size() <= 500))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('isFavorite' in data) || data.isFavorite is bool)
        && (!('industry' in data) || (data.industry is string && data.industry.size() <= 100))
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('relationshipStatus' in data) || (data.relationshipStatus in ['lead', 'initial_contact', 'active', 'follow_up_needed', 'inactive']))
        && (!('importance' in data) || (data.importance in ['high', 'medium', 'low']))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('website' in data) || (data.website is string && data.website.size() <= 250))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('source' in data) || (data.source is string && data.source.size() <= 150))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('contacts' in data) || (data.contacts is list && data.contacts.size() <= 25))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Meeting Validation
    function isValidMeeting(data, userId) {
      return data.keys().hasOnly([
          'id', 'userId', 'clientId', 'title', 'dateTime', 'duration', 'type',
          'location', 'notes', 'status', 'photoPaths', 'isFollowUpScheduled', 'attendees',
          'participants', 'agendaItems', 'discussionSummary', 'decisions',
          'followUpDateTime', 'minutesStatus', 'minutesStatusUpdatedAt',
          'minutesIncludedSections', 'minutesAdditionalNotes', 'appliedTemplateId',
          'opportunityId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['id', 'clientId', 'title', 'dateTime', 'type', 'status', 'notes'])
        && data.id is string && isValidId(data.id)
        && data.clientId is string && isValidId(data.clientId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.dateTime is string && data.dateTime.size() <= 50
        && data.type in ['in_person', 'phone', 'video', 'chat']
        && data.status in ['draft', 'confirmed', 'completed', 'cancelled']
        && data.notes is string && data.notes.size() <= 10000
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('duration' in data) || (data.duration is number && data.duration >= 0 && data.duration <= 1440))
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('photoPaths' in data) || (data.photoPaths is list && data.photoPaths.size() <= 20))
        && (!('isFollowUpScheduled' in data) || data.isFollowUpScheduled is bool)
        && (!('attendees' in data) || (data.attendees is list && data.attendees.size() <= 50))
        && (!('participants' in data) || (data.participants is list && data.participants.size() <= 50))
        && (!('agendaItems' in data) || (data.agendaItems is list && data.agendaItems.size() <= 60))
        && (!('discussionSummary' in data) || (data.discussionSummary is string && data.discussionSummary.size() <= 15000))
        && (!('decisions' in data) || (data.decisions is list && data.decisions.size() <= 60))
        && (!('followUpDateTime' in data) || (data.followUpDateTime is string && data.followUpDateTime.size() <= 50))
        && (!('minutesStatus' in data) || (data.minutesStatus in ['draft', 'review', 'final']))
        && (!('minutesStatusUpdatedAt' in data) || (data.minutesStatusUpdatedAt is string && data.minutesStatusUpdatedAt.size() <= 50))
        && (!('minutesIncludedSections' in data) || (data.minutesIncludedSections is list && data.minutesIncludedSections.size() <= 12))
        && (!('minutesAdditionalNotes' in data) || (data.minutesAdditionalNotes is string && data.minutesAdditionalNotes.size() <= 5000))
        && (!('appliedTemplateId' in data) || (data.appliedTemplateId is string && data.appliedTemplateId.size() <= 100))
        && (!('opportunityId' in data) || (data.opportunityId is string && isValidId(data.opportunityId)))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Task Validation
    function isValidTask(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'meetingId', 'clientId', 'opportunityId', 'title', 'description', 'dueDate', 'priority', 'status', 'reminderDate', 'completedAt', 'provenance', 'createdAt'])
        && data.keys().hasAll(['id', 'clientId', 'title', 'priority', 'status'])
        && data.id is string && isValidId(data.id)
        && data.clientId is string && isValidId(data.clientId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.priority in ['urgent', 'high', 'medium', 'low']
        && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('meetingId' in data) || (data.meetingId is string && isValidId(data.meetingId)))
        && (!('opportunityId' in data) || (data.opportunityId is string && isValidId(data.opportunityId)))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 50))
        && (!('reminderDate' in data) || (data.reminderDate is string && data.reminderDate.size() <= 50))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50))
        && (!('provenance' in data) || (data.provenance in ['source', 'ai_suggested', 'approved', 'uncertain']))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Note Validation
    function isValidNote(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'clientId', 'title', 'content', 'tags', 'isPinned', 'color', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'title', 'content', 'isPinned'])
        && data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 5000
        && data.isPinned is bool
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('clientId' in data) || (data.clientId is string && isValidId(data.clientId)))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Meeting Attachment Metadata Validation (Backblaze B2 metadata only; never stores secrets or presigned URLs)
    function isValidMeetingAttachment(data, userId, meetingId, attachmentId) {
      return data.keys().hasOnly([
          'id', 'userId', 'meetingId', 'fileName', 'contentType',
          'sizeBytes', 'storageKey', 'storageProvider', 'uploadStatus',
          'etag', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'id', 'userId', 'meetingId', 'fileName', 'contentType',
          'sizeBytes', 'storageKey', 'storageProvider', 'uploadStatus', 'createdAt'
        ])
        && data.id is string && isValidId(data.id) && data.id == attachmentId
        && data.userId is string && data.userId == userId
        && data.meetingId is string && isValidId(data.meetingId) && data.meetingId == meetingId
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes <= 10485760
        && data.storageKey is string
        && data.storageKey == ('users/' + userId + '/meetings/' + meetingId + '/attachments/' + attachmentId)
        && data.storageProvider == 'backblaze_b2'
        && data.uploadStatus == 'completed'
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50
        && (!('etag' in data) || (data.etag is string && data.etag.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Reminder State Validation (Per-user in-app reminders, snooze, and resolution metadata)
    function isValidReminderState(data, userId) {
      return data.keys().hasOnly([
          'id', 'userId', 'sourceType', 'sourceId', 'reason', 'clientId',
          'status', 'sourceFingerprint', 'snoozedUntil', 'resolvedAt',
          'invalidatedAt', 'invalidationReason', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['id', 'sourceType', 'sourceId', 'reason', 'status', 'sourceFingerprint'])
        && data.id is string && isValidId(data.id)
        && data.sourceType in ['task', 'meeting', 'client', 'opportunity']
        && data.sourceId is string && isValidId(data.sourceId)
        && data.reason in [
          'task_overdue', 'task_due_today', 'task_due_soon', 'task_high_priority',
          'meeting_imminent', 'meeting_follow_up', 'client_stale_contact',
          'opportunity_overdue_action', 'opportunity_closing_soon',
          'opportunity_missing_next_action', 'opportunity_stale'
        ]
        && data.status in ['snoozed', 'resolved', 'invalidated']
        && data.sourceFingerprint is string && data.sourceFingerprint.size() > 0 && data.sourceFingerprint.size() <= 200
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('clientId' in data) || (data.clientId is string && isValidId(data.clientId)))
        && (!('snoozedUntil' in data) || (data.snoozedUntil is string && data.snoozedUntil.size() <= 50))
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 50))
        && (!('invalidatedAt' in data) || (data.invalidatedAt is string && data.invalidatedAt.size() <= 50))
        && (!('invalidationReason' in data) || (data.invalidationReason is string && data.invalidationReason.size() <= 200))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Follow-Up & Reminder Preferences Validation
    function isValidFollowUpPreference(data, userId) {
      return data.keys().hasOnly([
          'id', 'userId', 'remindersEnabled', 'showOverdueTasks', 'showUpcomingMeetings',
          'meetingLeadMinutes', 'upcomingTaskWindowDays', 'showStaleClients',
          'staleClientDays', 'updatedAt'
        ])
        && data.keys().hasAll([
          'id', 'remindersEnabled', 'showOverdueTasks', 'showUpcomingMeetings',
          'meetingLeadMinutes', 'upcomingTaskWindowDays', 'showStaleClients'
        ])
        && data.id is string && isValidId(data.id)
        && data.remindersEnabled is bool
        && data.showOverdueTasks is bool
        && data.showUpcomingMeetings is bool
        && data.showStaleClients is bool
        && data.meetingLeadMinutes in [15, 30, 60, 120, 1440]
        && data.upcomingTaskWindowDays in [0, 2, 3, 7]
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('staleClientDays' in data) || (data.staleClientDays is number && data.staleClientDays >= 7 && data.staleClientDays <= 365))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Opportunity Validation (Task 008: Business Opportunities & Relationship Pipeline)
    function isValidDateOnlyString(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidOpportunity(data, userId) {
      return data.keys().hasOnly([
          'id', 'userId', 'clientId', 'title', 'description', 'type', 'stage',
          'priority', 'estimatedValue', 'currency', 'expectedCloseDate',
          'nextAction', 'nextActionDate', 'source', 'lostReason',
          'closedAt', 'reopenedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['id', 'clientId', 'title', 'type', 'stage', 'priority', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.clientId is string && isValidId(data.clientId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.type in ['service', 'consulting', 'retainer', 'partnership', 'project', 'other']
        && data.stage in ['new', 'qualification', 'proposal', 'negotiation', 'won', 'lost']
        && data.priority in ['urgent', 'high', 'medium', 'low']
        && (!('userId' in data) || (data.userId is string && data.userId == userId))
        && (!('description' in data) || (data.description is string && data.description.size() <= 3000))
        && (!('estimatedValue' in data) || (data.estimatedValue is number && data.estimatedValue >= 0 && data.estimatedValue <= 1000000000 && ('currency' in data)))
        && (!('currency' in data) || (data.currency in ['JOD', 'SAR', 'USD', 'EUR', 'AED', 'EGP']))
        && (!('expectedCloseDate' in data) || isValidDateOnlyString(data.expectedCloseDate))
        && (!('nextAction' in data) || (data.nextAction is string && data.nextAction.size() <= 300))
        && (!('nextActionDate' in data) || isValidDateOnlyString(data.nextActionDate))
        && (!('source' in data) || (data.source is string && data.source.size() <= 150))
        && (!('lostReason' in data) || (data.lostReason is string && data.lostReason.size() <= 500))
        && (!('closedAt' in data) || (data.closedAt is string && data.closedAt.size() <= 50))
        && (!('reopenedAt' in data) || (data.reopenedAt is string && data.reopenedAt.size() <= 50))
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50;
    }

    // Opportunity Stage Event Validation (Append-only operational stage transition log)
    function isValidOpportunityStageEvent(data, userId) {
      return data.keys().hasOnly([
          'id', 'userId', 'opportunityId', 'eventType', 'fromStage', 'toStage', 'note', 'occurredAt'
        ])
        && data.keys().hasAll(['id', 'opportunityId', 'eventType', 'toStage', 'occurredAt'])
        && data.id is string && isValidId(data.id)
        && data.opportunityId is string && isValidId(data.opportunityId)
        && data.eventType in ['created', 'stage_changed', 'closed_won', 'closed_lost', 'reopened']
        && (!('fromStage' in data) || (data.fromStage in ['new', 'qualification', 'proposal', 'negotiation', 'won', 'lost']))
        && data.toStage in ['new', 'qualification', 'proposal', 'negotiation', 'won', 'lost']
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.occurredAt is string && data.occurredAt.size() > 0 && data.occurredAt.size() <= 50
        && (!('userId' in data) || (data.userId is string && data.userId == userId));
    }

    // 5. User-Scoped Data Hierarchy (/users/{userId}/...)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && isValidUserProfile(incoming(), userId);
      allow delete: if false;

      // Scoped Subcollection: Clients
      match /clients/{clientId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(clientId)
          && incoming().id == clientId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidClient(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(clientId)
          && incoming().id == clientId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidClient(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      // Scoped Subcollection: Meetings
      match /meetings/{meetingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(meetingId)
          && incoming().id == meetingId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidMeeting(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(meetingId)
          && incoming().id == meetingId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidMeeting(incoming(), userId);
        allow delete: if isOwner(userId)
          && isValidId(meetingId)
          && !hasMeetingAttachmentLock(userId, meetingId);

        // Scoped Subcollection: Meeting Attachments (Server-authoritative commits & deletes only)
        match /attachments/{attachmentId} {
          allow get: if isOwner(userId) && isValidId(meetingId) && isValidId(attachmentId);
          allow list: if isOwner(userId) && isValidId(meetingId);
          allow create: if false;
          allow update: if false;
          allow delete: if false;
        }

        // Server-only Upload Intents & Meeting Attachment Guard (Strictly inaccessible to browser clients)
        match /uploadIntents/{intentId} {
          allow read, write: if false;
        }
      }

      // Scoped Subcollection: Tasks
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidTask(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidTask(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Scoped Subcollection: Notes
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidNote(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidNote(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Scoped Subcollection: Reminders State (Snooze / Resolution / Invalidation)
      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(reminderId)
          && incoming().id == reminderId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidReminderState(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(reminderId)
          && incoming().id == reminderId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidReminderState(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(reminderId);
      }

      // Scoped Subcollection: Per-User Preferences
      match /preferences/{preferenceId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(preferenceId)
          && incoming().id == preferenceId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidFollowUpPreference(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(preferenceId)
          && incoming().id == preferenceId
          && incoming().id == existing().id
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidFollowUpPreference(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(preferenceId);
      }

      // Scoped Subcollection: Business Opportunities & Relationship Pipeline
      match /opportunities/{opportunityId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(opportunityId)
          && incoming().id == opportunityId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidOpportunity(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(opportunityId)
          && incoming().id == opportunityId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && (!('userId' in existing()) || incoming().userId == existing().userId)
          && isValidOpportunity(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(opportunityId);
      }

      // Scoped Subcollection: Opportunity Stage History Events (Separate docs prevent concurrent array overwrite)
      match /opportunityStageEvents/{eventId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(eventId)
          && incoming().id == eventId
          && (!('userId' in incoming()) || incoming().userId == userId)
          && isValidOpportunityStageEvent(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(eventId);
      }
    }
  }
}
