{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A client or business contact in Murafiq CRM.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 2000 },
        "avatarPath": { "type": "string", "maxLength": 500 },
        "color": { "type": "string", "maxLength": 20 },
        "isFavorite": { "type": "boolean" },
        "industry": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 80 },
        "relationshipStatus": {
          "type": "string",
          "enum": ["lead", "initial_contact", "active", "follow_up_needed", "inactive"]
        },
        "importance": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "tags": { "type": "array" },
        "website": { "type": "string", "maxLength": 250 },
        "address": { "type": "string", "maxLength": 300 },
        "source": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "contacts": {
          "type": "array",
          "description": "Embedded bounded list (<= 25) of ClientContact objects belonging to this client"
        },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "A client meeting with preparation notes, minutes, and attached photos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "dateTime": { "type": "string", "maxLength": 50 },
        "duration": { "type": "number" },
        "type": { "type": "string", "enum": ["in_person", "phone", "video", "chat"] },
        "location": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 10000 },
        "status": { "type": "string", "enum": ["draft", "confirmed", "completed", "cancelled"] },
        "photoPaths": { "type": "array" },
        "isFollowUpScheduled": { "type": "boolean" },
        "attendees": { "type": "array" },
        "participants": { "type": "array" },
        "agendaItems": { "type": "array" },
        "discussionSummary": { "type": "string", "maxLength": 15000 },
        "decisions": { "type": "array" },
        "followUpDateTime": { "type": "string", "maxLength": 50 },
        "minutesStatus": { "type": "string", "enum": ["draft", "review", "final"] },
        "minutesStatusUpdatedAt": { "type": "string", "maxLength": 50 },
        "minutesIncludedSections": { "type": "array" },
        "minutesAdditionalNotes": { "type": "string", "maxLength": 5000 },
        "appliedTemplateId": { "type": "string", "maxLength": 100 },
        "opportunityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "title", "dateTime", "type", "status", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "An action item or follow-up commitment linked to a client and/or meeting.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "meetingId": { "type": "string", "maxLength": 128 },
        "opportunityId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "cancelled"] },
        "reminderDate": { "type": "string", "maxLength": 50 },
        "completedAt": { "type": "string", "maxLength": 50 },
        "provenance": { "type": "string", "enum": ["source", "ai_suggested", "approved", "uncertain"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "title", "priority", "status", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A general note or checklist with tags and color categorization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "tags": { "type": "array" },
        "isPinned": { "type": "boolean" },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "content", "createdAt"]
    },
    "MeetingAttachment": {
      "title": "MeetingAttachment",
      "description": "Server-verified metadata for an attachment stored in Backblaze B2 under a user's meeting.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "meetingId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 255 },
        "contentType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"] },
        "sizeBytes": { "type": "number" },
        "storageKey": { "type": "string", "maxLength": 512 },
        "storageProvider": { "type": "string", "enum": ["backblaze_b2"] },
        "uploadStatus": { "type": "string", "enum": ["completed"] },
        "deleteStatus": { "type": "string", "enum": ["active", "deleting", "b2_deleted", "delete_failed"] },
        "deleteErrorArabic": { "type": "string", "maxLength": 500 },
        "etag": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "meetingId", "fileName", "contentType", "sizeBytes", "storageKey", "storageProvider", "uploadStatus", "createdAt"]
    },
    "UploadIntent": {
      "title": "UploadIntent",
      "description": "Server-only upload authorization and commit tracking record for Backblaze B2 attachments.",
      "type": "object",
      "properties": {
        "attachmentId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "meetingId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 255 },
        "contentType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"] },
        "sizeBytes": { "type": "number" },
        "storageKey": { "type": "string", "maxLength": 512 },
        "bucket": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "committing", "committed", "cleaning", "abandoned", "deleted"] },
        "expiresAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "committedAt": { "type": "string", "maxLength": 50 },
        "committingLeaseExpiresAt": { "type": "string", "maxLength": 50 },
        "cleaningStartedAt": { "type": "string", "maxLength": 50 },
        "cleanedAt": { "type": "string", "maxLength": 50 },
        "cleanupReason": { "type": "string", "enum": ["client_abandoned", "expired_uncommitted", "verification_failed"] }
      },
      "required": ["attachmentId", "userId", "meetingId", "fileName", "contentType", "sizeBytes", "storageKey", "status", "expiresAt", "createdAt", "updatedAt"]
    },
    "ReminderState": {
      "title": "ReminderState",
      "description": "User-isolated snooze, resolution, or invalidation state for a deterministic reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "sourceType": { "type": "string", "enum": ["task", "meeting", "client", "opportunity"] },
        "sourceId": { "type": "string", "maxLength": 128 },
        "reason": {
          "type": "string",
          "enum": [
            "task_overdue",
            "task_due_today",
            "task_due_soon",
            "task_high_priority",
            "meeting_imminent",
            "meeting_follow_up",
            "client_stale_contact",
            "opportunity_overdue_action",
            "opportunity_closing_soon",
            "opportunity_missing_next_action",
            "opportunity_stale"
          ]
        },
        "clientId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["snoozed", "resolved", "invalidated"] },
        "sourceFingerprint": { "type": "string", "maxLength": 200 },
        "snoozedUntil": { "type": "string", "maxLength": 50 },
        "resolvedAt": { "type": "string", "maxLength": 50 },
        "invalidatedAt": { "type": "string", "maxLength": 50 },
        "invalidationReason": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "sourceType", "sourceId", "reason", "status", "sourceFingerprint"]
    },
    "FollowUpPreference": {
      "title": "FollowUpPreference",
      "description": "User-isolated follow-up and in-app reminder preferences.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "remindersEnabled": { "type": "boolean" },
        "showOverdueTasks": { "type": "boolean" },
        "showUpcomingMeetings": { "type": "boolean" },
        "meetingLeadMinutes": { "type": "number" },
        "upcomingTaskWindowDays": { "type": "number" },
        "showStaleClients": { "type": "boolean" },
        "staleClientDays": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": [
        "id",
        "remindersEnabled",
        "showOverdueTasks",
        "showUpcomingMeetings",
        "meetingLeadMinutes",
        "upcomingTaskWindowDays",
        "showStaleClients"
      ]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "A user-isolated business opportunity or collaboration linked to a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "type": { "type": "string", "enum": ["service", "consulting", "retainer", "partnership", "project", "other"] },
        "stage": { "type": "string", "enum": ["new", "qualification", "proposal", "negotiation", "won", "lost"] },
        "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low"] },
        "estimatedValue": { "type": "number" },
        "currency": { "type": "string", "enum": ["JOD", "SAR", "USD", "EUR", "AED", "EGP"] },
        "expectedCloseDate": { "type": "string", "maxLength": 50, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "nextAction": { "type": "string", "maxLength": 300 },
        "nextActionDate": { "type": "string", "maxLength": 50, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "maxLength": 150 },
        "lostReason": { "type": "string", "maxLength": 500 },
        "closedAt": { "type": "string", "maxLength": 50 },
        "reopenedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "title", "type", "stage", "priority", "createdAt", "updatedAt"]
    },
    "OpportunityStageEvent": {
      "title": "OpportunityStageEvent",
      "description": "Immutable operational stage transition record for an opportunity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "opportunityId": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "enum": ["created", "stage_changed", "closed_won", "closed_lost", "reopened"] },
        "fromStage": { "type": "string", "enum": ["new", "qualification", "proposal", "negotiation", "won", "lost"] },
        "toStage": { "type": "string", "enum": ["new", "qualification", "proposal", "negotiation", "won", "lost"] },
        "note": { "type": "string", "maxLength": 500 },
        "occurredAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "opportunityId", "eventType", "toStage", "occurredAt"]
    }
  },
  "firestore": {
    "/users/{userId}/clients/{clientId}": {
      "schema": { "$ref": "entities/Client" },
      "description": "Stores user-isolated clients and business contacts"
    },
    "/users/{userId}/meetings/{meetingId}": {
      "schema": { "$ref": "entities/Meeting" },
      "description": "Stores user-isolated meetings, agendas, minutes, and photos"
    },
    "/users/{userId}/meetings/{meetingId}/attachments/{attachmentId}": {
      "schema": { "$ref": "entities/MeetingAttachment" },
      "description": "Stores server-committed, user-isolated Backblaze B2 attachment metadata scoped to a meeting"
    },
    "/users/{userId}/meetings/{meetingId}/uploadIntents/{intentId}": {
      "schema": { "$ref": "entities/UploadIntent" },
      "description": "Server-only upload authorization intents (blocked for client SDK access)"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "entities/Task" },
      "description": "Stores user-isolated actionable follow-up items and commitments"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "entities/Note" },
      "description": "Stores user-isolated reference notes and checklists"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "entities/ReminderState" },
      "description": "Stores user-isolated reminder snooze, resolution, and invalidation state"
    },
    "/users/{userId}/preferences/{preferenceId}": {
      "schema": { "$ref": "entities/FollowUpPreference" },
      "description": "Stores user-isolated follow-up and reminder preferences"
    },
    "/users/{userId}/opportunities/{opportunityId}": {
      "schema": { "$ref": "entities/Opportunity" },
      "description": "Stores user-isolated business opportunities and pipeline state"
    },
    "/users/{userId}/opportunityStageEvents/{eventId}": {
      "schema": { "$ref": "entities/OpportunityStageEvent" },
      "description": "Stores append-only operational stage transition events for opportunities"
    }
  }
}
